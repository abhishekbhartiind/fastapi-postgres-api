# ==============================================================================
# Application Configuration
# ==============================================================================
PROJECT_NAME="FastAPI Postgres Service"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# ==============================================================================
# Security & JWT Configuration
# Generate a secure secret in terminal: openssl rand -hex 32
# ==============================================================================
SECRET_KEY="change_this_to_a_very_secure_random_secret_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==============================================================================
# PostgreSQL Database Configuration
# Local SQLite fallback: sqlite+aiosqlite:///./sql_app.db
# Docker Postgres: postgresql+asyncpg://postgres:postgres@db:5432/app_db
# ==============================================================================
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/app_db"

POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app_db
